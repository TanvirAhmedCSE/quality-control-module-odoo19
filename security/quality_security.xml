<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="0" so groups/privileges update on module upgrade -->
    <data noupdate="0">
        <!-- Category = section title on the user form -->
        <record id="module_category_quality_check" model="ir.module.category">
            <field name="name">Quality Management</field>
            <field name="sequence">30</field>
        </record>
        <!-- Privilege -->
        <record id="privilege_quality_check" model="res.groups.privilege">
            <field name="name">Quality Level1</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_quality_check" />
        </record>

        <!-- Groups -->
        <record id="group_quality_check_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_quality_check" />
        </record>

        <record id="group_quality_check_supervisor" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_quality_check" />
        </record>

        <record id="group_quality_check_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="privilege_quality_check" />
        </record>
    </data>
</odoo>